{
  "buildCommand": "node scripts/bundle-api.mjs && npx vite build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15
    },
    "api/health.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api/|catalogue/).*)", "destination": "/index.html" }
  ]
}
